{
  "applicationId": "REVIEWED_APPLICATION_ID",
  "executionRoleArn": "REVIEWED_EXECUTION_ROLE_ARN",
  "name": "mdep-74-backfill-validation",
  "mode": "BATCH",
  "executionTimeoutMinutes": 30,
  "retryPolicy": {
    "maxAttempts": 1
  },
  "jobDriver": {
    "sparkSubmit": {
      "entryPoint": "s3://REVIEWED_DATA_BUCKET/scripts/aws08/aws08_backfill_validation_job.py",
      "entryPointArguments": [
        "--data-bucket", "REVIEWED_DATA_BUCKET",
        "--catalog", "glue_catalog",
        "--namespace", "REVIEWED_SILVER_DATABASE",
        "--manifest-key", "bronze/rest_api/exchange_rates/REVIEWED/_COMMITTED.json",
        "--manifest-key", "bronze/rest_api/locations/REVIEWED/_COMMITTED.json",
        "--validation-run-identity", "REVIEWED_UUID",
        "--expected-interval-start", "REVIEWED_UTC_START",
        "--expected-interval-end", "REVIEWED_UTC_END",
        "--report-key", "validation/reports/REVIEWED_UUID.json",
        "--kms-key-id", "REVIEWED_KMS_KEY_ARN"
      ],
      "sparkSubmitParameters": "--py-files s3://REVIEWED_DATA_BUCKET/scripts/aws08/aws08_validation_package.zip --conf spark.jars=/usr/share/aws/iceberg/lib/iceberg-spark3-runtime.jar --conf spark.sql.extensions=org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions --conf spark.sql.catalog.glue_catalog=org.apache.iceberg.spark.SparkCatalog --conf spark.sql.catalog.glue_catalog.catalog-impl=org.apache.iceberg.aws.glue.GlueCatalog --conf spark.sql.catalog.glue_catalog.io-impl=org.apache.iceberg.aws.s3.S3FileIO --conf spark.sql.catalog.glue_catalog.warehouse=s3://REVIEWED_DATA_BUCKET/iceberg/ --conf spark.dynamicAllocation.minExecutors=1 --conf spark.dynamicAllocation.initialExecutors=1 --conf spark.dynamicAllocation.maxExecutors=1"
    }
  },
  "configurationOverrides": {
    "monitoringConfiguration": {
      "s3MonitoringConfiguration": {
        "logUri": "s3://REVIEWED_DATA_BUCKET/validation/logs/"
      }
    }
  }
}
