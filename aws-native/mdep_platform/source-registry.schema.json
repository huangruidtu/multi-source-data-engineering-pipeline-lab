{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MDEP source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "sources"],
  "properties": {
    "registry_version": {"const": "mdep-source-registry-v1"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "source_entity", "contract_version", "enabled", "max_records", "owner", "description"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "source_type": {"enum": ["rest_api", "csv_file", "json_file"]},
        "source_entity": {"type": "string", "minLength": 1, "maxLength": 64},
        "contract_version": {"const": "mdep-6-v1"},
        "enabled": {"type": "boolean"},
        "max_records": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_pages": {"type": "integer", "minimum": 1, "maximum": 100},
        "owner": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9 ._@/-]{2,127}$"},
        "description": {"type": "string", "minLength": 5, "maxLength": 256},
        "local_path": {"type": "string", "minLength": 1, "maxLength": 256},
        "endpoint_env": {"type": "string", "pattern": "^MDEP_[A-Z0-9_]+_URL$"},
        "allowed_hosts": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "format": "hostname"}}
      },
      "allOf": [
        {
          "if": {"properties": {"source_type": {"const": "rest_api"}}},
          "then": {"required": ["endpoint_env", "allowed_hosts", "max_pages"], "not": {"required": ["local_path"]}},
          "else": {"required": ["local_path"], "not": {"anyOf": [{"required": ["endpoint_env"]}, {"required": ["allowed_hosts"]}, {"required": ["max_pages"]}]}}
        }
      ]
    }
  }
}
